{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Last Played",
  "version": "1.0.0",
  "identifier": "com.hadi.last-played",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Last Played",
        "width": 800,
        "height": 600,
        "maximized": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "Track and resume your local movie and TV library.",
    "longDescription": "Last Played builds a personal library from local video files, adds metadata from TMDB, plays anything through embedded libVLC, and keeps watch progress in sync across your devices.",
    "copyright": "Copyright (c) 2026 Hadi. All rights reserved.",
    "resources": ["vlc/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
